
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Products {
  id    String @id @default(uuid())
  name  String
  price String
  quantity String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
